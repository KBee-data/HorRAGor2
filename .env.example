# Copier ce fichier en .env et remplir les valeurs (le .env n'est JAMAIS commite).

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Modeles : stack locale Ollama (aucune cle API) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
