%% Graphe de l'agent — GENERE automatiquement depuis le code (LangGraph).
%% Regenerer : uv run horragor-graph > docs/graphe_agent_genere.mmd
%% Export image : coller dans https://mermaid.live -> Actions -> SVG
---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	agent(agent)
	tools(tools)
	judge(judge)
	__end__([<p>__end__</p>]):::last
	__start__ --> agent;
	agent -.-> judge;
	agent -.-> tools;
	judge -.-> __end__;
	judge -.-> agent;
	tools --> agent;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
